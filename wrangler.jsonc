{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jiwo-probe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "PROBE_HUB",
        "class_name": "ProbeHub"
      }
    ]
  },
  "exports": {
    "ProbeHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/login"]
  }
}
