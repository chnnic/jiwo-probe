# 复制为 .dev.vars 后填写。不要把 .dev.vars 提交到 Git。
MMWX_ORIGIN=https://panel.example.com
PROBE_TOKEN=replace-with-the-generated-probe-token
PROBE_POLL_INTERVAL_SECONDS=3
# 网速显示单位：bits 或 bytes（不影响 Ran 与累计流量）。
PROBE_NETWORK_SPEED_UNIT=bits
# 首页 TCP/UDP 小折线：true 开启、false 关闭；连接数数字和详情历史不变。
PROBE_SHOW_CONNECTION_CHART=true
